rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // PDF artifacts generated by Cloud Functions
    match /artifacts/{projectId}/patchJobs/{patchJobId}/pdfs/{fileName} {
      // Allow authenticated users to read PDFs for their accessible projects
      allow read: if request.auth != null;
      // Only allow server-side writes (Cloud Functions use admin SDK, bypass rules)
      allow write: if false;
    }
    
    // Photo uploads from patch jobs
    match /artifacts/{projectId}/patchJobs/{patchJobId}/photos/{fileName} {
      // Allow authenticated users to read and write photos
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
